# Copy this to .env in this folder and fill it in.

# Required. Free tier: 15 requests a minute, 500 a day.
GOOGLE_API_KEY=your_google_api_key_here

# Required for the sandboxes, unless you use Docker (below). The key you made for W09b.2.
DAYTONA_API_KEY=your_daytona_api_key_here

# Optional: run the sandboxes in Docker on your own machine instead of Daytona. Start Docker Desktop
# and run `docker pull python:3.12-slim` once first.
# SANDBOX=docker

# Optional, for development: run every chat call through Ollama instead of Gemini, so building and
# debugging do not spend the quota. Remove this line for notebooks 02 and 03.
# CHAT_BACKEND=ollama
# OLLAMA_CHAT_MODEL=qwen3.5:9b

# Optional: an OpenAI or Anthropic model instead of Gemini. Say so in your write-up, since your
# numbers will then not be comparable with Gemini runs.
# CHAT_BACKEND=openai
# OPENAI_API_KEY=...
# CHAT_BACKEND=anthropic
# ANTHROPIC_API_KEY=...

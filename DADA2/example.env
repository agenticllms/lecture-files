# Copy this to .env in this folder and fill it in.

# Required. Free tier: 15 requests a minute, 500 a day.
GOOGLE_API_KEY='your_key_here'

# Required.
PINECONE_API_KEY='your_key_here'
# The index name defaults to dada2- plus the vector size, e.g. dada2-1024.
# Only set this if you named your index something else.
# INDEX_NAME='dada2-1024'

# Required. Workers AI free tier is 10,000 neurons a day.
# Token: My Profile > API Tokens, with the "Workers AI" permission.
CLOUDFLARE_API_TOKEN='your_token_here'

# Required for notebook 02 onward: Cohere's reranker. Free tier.
COHERE_API_KEY='your_key_here'

# Embeddings. cloudflare is the default and uses the Cloudflare token above.
# ollama is the local backup, same model, same index: pull
# qwen3-embedding:0.6b and set this. gemini is the lecture model; indexing
# this corpus with it needs the paid tier.
# EMBEDDINGS='ollama'

# Optional, for development: run the chat model locally instead of Gemini,
# so iterating on notebooks 02 and 03 does not spend the 500-a-day quota.
# You need Ollama running with the model from Week 2 (ollama pull qwen3.5:4b).
# Remove this line for notebook 04 and before you deploy: Render uses Gemini.
# CHAT_BACKEND='ollama'
